# Server secrets for the Contact page and the MCP endpoint. Copy to `.env` for local
# development; never commit real values. In production they live only in Vercel's
# environment variables, the API keys as "Sensitive".

# Upstash Redis for rate limiting (issue #13). Set by the Upstash for Redis integration
# in the Vercel Marketplace; `vercel env pull` writes them for local development.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend, for delivering Messages (issue #11). Needs sending access to inomov.online.
RESEND_API_KEY=

# Cloudflare Turnstile (issue #11). These are Cloudflare's public test keys, which always
# pass; production uses the inomov.online widget.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# Cal.com, for Slots and booking Intro Calls (issue #10).
CALCOM_API_KEY=
