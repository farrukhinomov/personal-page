---
import { AI_CATALOG_PATH, AI_CATALOG_TYPE } from '@/mcp/discovery';
import { Font, getImage } from 'astro:assets';
import portrait from '@/assets/portrait/farrukh-inomov.jpg';
import SiteFooter from '@/components/site/SiteFooter.astro';
import SiteHeader from '@/components/site/SiteHeader.astro';
import { profile } from '@/data/profile';
import {
  DEFAULT_LOCALE,
  LANG_TAG,
  LOCALES,
  OG_LOCALE,
  otherLocale,
  type Locale,
  type Localized,
} from '@/i18n/locales';
import { pageMeta } from '@/i18n/pages';
import { pathFor, type RouteKey } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import { OG_IMAGE_SIZE, ogImagePath } from '@/seo/og';
import {
  graph,
  personSchema,
  serializeJsonLd,
  websiteSchema,
  type JsonLd,
} from '@/seo/structured-data';
import '@/styles/global.css';

interface Props {
  locale: Locale;
  /** The nav entry this page belongs to; highlights it in the header. */
  route?: RouteKey;
  /** Paths of this page in every locale. */
  alternates: Localized;
  /** Page title without the site name; omit on the start page. */
  title?: string;
  description?: string;
  /** Keeps the page out of search results and skips canonical/hreflang (e.g. 404). */
  noindex?: boolean;
  /** Generated Open Graph image (see src/seo/og.ts); defaults to the start page's. */
  ogImage?: string;
  /** Extra schema.org nodes for this page; Person and WebSite are always included. */
  structuredData?: JsonLd[];
  /** Marks the page as an article for link previews. */
  article?: { published: Date; updated?: Date | undefined; tags: readonly string[] };
}

/** Browser UI colour per theme; matches `--color-bg` in tokens.css. */
const THEME_COLOR = { dark: '#0e161d', light: '#f2f5f7' } as const;

const {
  locale,
  route,
  alternates,
  title,
  description,
  noindex = false,
  ogImage = ogImagePath(locale, 'home'),
  structuredData = [],
  article,
} = Astro.props;
const t = useTranslations(locale);

const fullTitle = title
  ? `${title} – ${profile.name}`
  : `${profile.name} – ${profile.headline[locale]}`;
const metaDescription = description ?? pageMeta('home', locale).description;
const canonical = new URL(alternates[locale], Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);
// A plain JPEG for search engines, which do not all read AVIF or WebP.
const portraitJpeg = await getImage({ src: portrait, width: 800, format: 'jpeg' });
const jsonLd = serializeJsonLd(
  graph([personSchema(locale, portraitJpeg.src), websiteSchema(locale), ...structuredData]),
);
const rssUrl = `${pathFor('blog', locale)}/rss.xml`;
---

<!doctype html>
<html lang={LANG_TAG[locale]} data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    {!noindex && (
      <>
        <link rel="canonical" href={canonical} />
        {LOCALES.map((l) => (
          <link rel="alternate" hreflang={LANG_TAG[l]} href={new URL(alternates[l], Astro.site)} />
        ))}
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(alternates[DEFAULT_LOCALE], Astro.site)}
        />
      </>
    )}

    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={OG_LOCALE[locale]} />
    <meta property="og:locale:alternate" content={OG_LOCALE[otherLocale(locale)]} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content={String(OG_IMAGE_SIZE.width)} />
    <meta property="og:image:height" content={String(OG_IMAGE_SIZE.height)} />
    <meta property="og:image:alt" content={title ?? profile.name} />
    {article && (
      <>
        <meta property="article:published_time" content={article.published.toISOString()} />
        {article.updated && (
          <meta property="article:modified_time" content={article.updated.toISOString()} />
        )}
        {article.tags.map((tag) => (
          <meta property="article:tag" content={tag} />
        ))}
      </>
    )}
    <meta name="twitter:card" content="summary_large_image" />

    <link
      rel="alternate"
      type="application/rss+xml"
      title={`${profile.name} – Blog`}
      href={rssUrl}
    />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <!-- Lets AI agents find the MCP endpoint (AI Catalog link relation). -->
    <link rel="ai-catalog" href={AI_CATALOG_PATH} type={AI_CATALOG_TYPE} />
    <script is:inline type="application/ld+json" set:html={jsonLd} />
    <!-- Follows the page theme; the theme scripts keep it in sync. -->
    <meta
      name="theme-color"
      content={THEME_COLOR.light}
      data-dark={THEME_COLOR.dark}
      data-light={THEME_COLOR.light}
    />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <!-- Not preloaded: a preload competes with the render-blocking CSS on slow connections
         (measured: LCP 1.9 s with, 1.5 s without). Text paints at once in the metric-matched
         fallback and swaps to Geist without moving (CLS 0.002). -->
    <Font cssVariable="--font-sans" />
    <Font cssVariable="--font-mono" />

    <!--
      Runs before first paint: marks that JavaScript is available and applies the stored
      theme, so there is no flash of the wrong theme.
    -->
    <script is:inline>
      document.documentElement.dataset.js = '';
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        document.documentElement.dataset.motion = '';
      }
      try {
        if (localStorage.getItem('theme') === 'dark') {
          document.documentElement.dataset.theme = 'dark';
          const meta = document.querySelector('meta[name="theme-color"]');
          if (meta) meta.content = meta.dataset.dark;
        }
      } catch {
        /* storage unavailable: keep the light default */
      }
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t('a11y.skip')}
    </a>
    <SiteHeader locale={locale} route={route} alternates={alternates} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter locale={locale} />
    <script>
      import '@/scripts/motion';
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: fixed;
    inset-block-start: var(--space-3);
    inset-inline-start: var(--space-3);
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-control);
    background: var(--color-signal);
    color: var(--color-signal-contrast);
    font-weight: 600;
    text-decoration: none;
    transform: translateY(-200%);
  }

  .skip-link:focus-visible {
    transform: none;
  }

  main:focus {
    outline: none;
  }
</style>
