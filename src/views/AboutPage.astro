---
import ExperienceTrace from '@/components/about/ExperienceTrace.astro';
import SkillGroups from '@/components/about/SkillGroups.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { experience } from '@/data/experience';
import { profile } from '@/data/profile';
import { skills } from '@/data/skills';
import type { Locale } from '@/i18n/locales';
import { pageMeta } from '@/i18n/pages';
import { alternatesFor, pathFor } from '@/i18n/routes';
import { ogImagePath } from '@/seo/og';
import { profilePageSchema } from '@/seo/structured-data';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  de: {
    experience: 'Werdegang',
    skills: 'Kenntnisse',
    languages: 'Sprachen',
    awards: 'Auszeichnungen',
  },
  en: {
    experience: 'Experience',
    skills: 'Skills',
    languages: 'Languages',
    awards: 'Awards',
  },
}[locale];
const meta = pageMeta('about', locale);
---

<BaseLayout
  locale={locale}
  route="about"
  alternates={alternatesFor('about')}
  title={meta.title}
  description={meta.description}
  ogImage={ogImagePath(locale, 'about')}
  structuredData={[profilePageSchema(pathFor('about', locale), locale)]}
>
  <PageHeader title={profile.headline[locale]} lead={profile.summary[locale]} />

  <section class="block" aria-labelledby="experience-title">
    <div class="container">
      <h2 id="experience-title" data-reveal="lines">
        {copy.experience}
      </h2>
      <ExperienceTrace locale={locale} entries={experience} />
    </div>
  </section>

  <section class="block" aria-labelledby="skills-title">
    <div class="container">
      <h2 id="skills-title" data-reveal="lines">
        {copy.skills}
      </h2>
      <SkillGroups locale={locale} groups={skills} />
    </div>
  </section>

  <section class="block" aria-labelledby="languages-title">
    <div class="container facts">
      <div>
        <h2 id="languages-title" data-reveal="lines">
          {copy.languages}
        </h2>
        <dl class="fact-list">
          {profile.languages.map((language) => (
            <div>
              <dt>{language.name[locale]}</dt>
              <dd>{language.level[locale]}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div>
        <h2>{copy.awards}</h2>
        <dl class="fact-list">
          {profile.awards.map((award) => (
            <div>
              <dt>{award.title[locale]}</dt>
              <dd>{award.year}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .block {
    padding-block-start: var(--space-8);
  }

  h2 {
    margin-block-end: var(--space-6);
    font-size: var(--step-3);
  }

  .facts {
    display: grid;
    gap: var(--space-7);
  }

  @media (min-width: 60rem) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .fact-list > div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: var(--space-3);
    border-block-end: 1px solid var(--color-line);
  }

  dt {
    font-weight: 500;
  }

  dd {
    color: var(--color-fg-muted);
    text-align: end;
  }
</style>
