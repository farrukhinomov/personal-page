---
import ContactBand from '@/components/home/ContactBand.astro';
import CurrentWork from '@/components/home/CurrentWork.astro';
import Flagship from '@/components/home/Flagship.astro';
import Hero from '@/components/home/Hero.astro';
import TerminalSection from '@/components/home/TerminalSection.astro';
import ProjectList from '@/components/projects/ProjectList.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { projects } from '@/data/projects';
import type { Locale } from '@/i18n/locales';
import { alternatesFor, pathFor } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
// The first Project is the flagship; the other featured ones follow it.
const [flagship, ...rest] = projects;
const moreFeatured = rest.filter((project) => project.featured);

const copy = {
  de: { projects: 'Weitere Projekte', all: 'Alle Projekte' },
  en: { projects: 'More projects', all: 'All projects' },
}[locale];
---

<BaseLayout locale={locale} route="home" alternates={alternatesFor('home')}>
  <Hero locale={locale} />
  {flagship && <Flagship locale={locale} project={flagship} />}

  {moreFeatured.length > 0 && (
    <section class="featured" aria-labelledby="featured-title">
      <div class="container">
        <div class="featured-head">
          <h2 id="featured-title" data-reveal="lines">
            {copy.projects}
          </h2>
          <ButtonLink href={pathFor('projects', locale)} variant="secondary">
            {copy.all}
          </ButtonLink>
        </div>
        <ProjectList locale={locale} projects={moreFeatured} />
      </div>
    </section>
  )}

  <TerminalSection locale={locale} alternates={alternatesFor('home')} />
  <CurrentWork locale={locale} />
  <ContactBand locale={locale} />
</BaseLayout>

<style>
  .featured {
    padding-block: var(--space-8) 0;
    border-block-start: 1px solid var(--color-line);
  }

  .featured-head {
    display: flex;
    flex-wrap: wrap;
    align-items: end;
    justify-content: space-between;
    gap: var(--space-4);
    margin-block-end: var(--space-6);
  }

  h2 {
    font-size: var(--step-3);
  }
</style>
