---
import AvailabilityNote from '@/components/ui/AvailabilityNote.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import PageHeader from '@/components/ui/PageHeader.astro';
import { profile } from '@/data/profile';
import type { Locale } from '@/i18n/locales';
import { alternatesFor } from '@/i18n/routes';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  de: {
    title: 'Kontakt',
    lead: 'Eine Stelle, ein Projekt oder eine Frage zu meiner Arbeit? Schreiben Sie mir – ich antworte persönlich.',
    email: 'E-Mail',
    emailHint: 'Der schnellste Weg zu mir.',
    linkedin: 'LinkedIn',
    linkedinHint: 'Werdegang und Empfehlungen.',
    github: 'GitHub',
    githubHint: 'Code und öffentliche Projekte.',
  },
  en: {
    title: 'Contact',
    lead: 'A role, a project or a question about my work? Write to me – I answer personally.',
    email: 'Email',
    emailHint: 'The fastest way to reach me.',
    linkedin: 'LinkedIn',
    linkedinHint: 'Career history and recommendations.',
    github: 'GitHub',
    githubHint: 'Code and public projects.',
  },
}[locale];

const channels: { label: string; hint: string; href: string; value: string; icon: IconName }[] = [
  {
    label: copy.email,
    hint: copy.emailHint,
    href: `mailto:${profile.email}`,
    value: profile.email,
    icon: 'mail',
  },
  {
    label: copy.linkedin,
    hint: copy.linkedinHint,
    href: profile.links.linkedin,
    value: 'in/farrukhinomov',
    icon: 'linkedin',
  },
  {
    label: copy.github,
    hint: copy.githubHint,
    href: profile.links.github,
    value: 'farrukhinomov',
    icon: 'github',
  },
];
---

<BaseLayout
  locale={locale}
  route="contact"
  alternates={alternatesFor('contact')}
  title={copy.title}
  description={copy.lead}
>
  <PageHeader title={copy.title} lead={copy.lead} />
  <div class="container">
    <AvailabilityNote locale={locale} />
    <ul class="channels">
      {channels.map((channel) => (
        <li>
          <a
            class="channel"
            href={channel.href}
            rel={channel.href.startsWith('http') ? 'me noopener' : undefined}
          >
            <span class="label">
              <Icon name={channel.icon} size={20} />
              {channel.label}
            </span>
            <span class="value">{channel.value}</span>
            <span class="hint">{channel.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .channels {
    display: grid;
    gap: var(--space-4);
    margin-block-start: var(--space-7);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 60rem) {
    .channels {
      grid-template-columns: 2fr 1fr 1fr;
    }
  }

  .channel {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .channel:hover {
    border-color: var(--color-signal);
    transform: translateY(-2px);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }

  .value {
    font-size: var(--step-1);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .hint {
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }
</style>
