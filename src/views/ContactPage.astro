---
import MessageForm from '@/components/contact/MessageForm.astro';
import Icon from '@/components/ui/Icon.astro';
import type { IconName } from '@/components/ui/icons';
import PageHeader from '@/components/ui/PageHeader.astro';
import { profile } from '@/data/profile';
import type { Locale } from '@/i18n/locales';
import { pageMeta } from '@/i18n/pages';
import { alternatesFor } from '@/i18n/routes';
import { ogImagePath } from '@/seo/og';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const copy = {
  de: {
    email: 'E-Mail',
    emailHint: 'Der schnellste Weg zu mir.',
    linkedin: 'LinkedIn',
    linkedinHint: 'Werdegang und Empfehlungen.',
    github: 'GitHub',
    githubHint: 'Code und öffentliche Projekte.',
  },
  en: {
    email: 'Email',
    emailHint: 'The fastest way to reach me.',
    linkedin: 'LinkedIn',
    linkedinHint: 'Career history and recommendations.',
    github: 'GitHub',
    githubHint: 'Code and public projects.',
  },
}[locale];
const meta = pageMeta('contact', locale);

// The Turnstile bot check of the Message form runs from Cloudflare, on this page only.
// The form's script is large enough to ship as a file, which the hashes alone would block.
const TURNSTILE_ORIGIN = 'https://challenges.cloudflare.com';
Astro.csp?.insertScriptResource("'self'");
Astro.csp?.insertScriptResource(TURNSTILE_ORIGIN);
Astro.csp?.insertDirective(`frame-src ${TURNSTILE_ORIGIN}`);

const channels: { label: string; hint: string; href: string; value: string; icon: IconName }[] = [
  {
    label: copy.email,
    hint: copy.emailHint,
    href: `mailto:${profile.email}`,
    value: profile.email,
    icon: 'mail',
  },
  {
    label: copy.linkedin,
    hint: copy.linkedinHint,
    href: profile.links.linkedin,
    value: new URL(profile.links.linkedin).pathname.slice(1),
    icon: 'linkedin',
  },
  {
    label: copy.github,
    hint: copy.githubHint,
    href: profile.links.github,
    value: 'farrukhinomov',
    icon: 'github',
  },
];
---

<BaseLayout
  locale={locale}
  route="contact"
  alternates={alternatesFor('contact')}
  title={meta.title}
  description={meta.description}
  ogImage={ogImagePath(locale, 'contact')}
>
  <PageHeader title={meta.title} lead={meta.description} />
  <div class="container layout">
    <MessageForm locale={locale} />
    <ul class="channels">
      {channels.map((channel) => (
        <li>
          <a
            class="channel"
            href={channel.href}
            rel={channel.href.startsWith('http') ? 'me noopener' : undefined}
          >
            <span class="label">
              <Icon name={channel.icon} size={20} />
              {channel.label}
            </span>
            <span class="value">{channel.value}</span>
            <span class="hint">{channel.hint}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<style>
  .layout {
    display: grid;
    gap: var(--space-7);
    margin-block-start: var(--space-7);
  }

  /* The form leads; the direct channels sit beside it on wide screens and below it on phones. */
  @media (min-width: 60rem) {
    .layout {
      grid-template-columns: minmax(0, 2fr) minmax(16rem, 1fr);
      align-items: start;
    }

    .channels {
      margin-block-start: calc(var(--step-2) * 1.2 + var(--space-5));
    }
  }

  .channels {
    display: grid;
    gap: var(--space-4);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .channel {
    display: grid;
    gap: var(--space-1);
    height: 100%;
    padding: var(--space-5);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-panel);
    background: var(--color-surface);
    text-decoration: none;
    transition:
      border-color var(--duration-base) var(--ease-out),
      transform var(--duration-base) var(--ease-out);
  }

  .channel:hover {
    border-color: var(--color-signal);
    transform: translateY(-2px);
  }

  .label {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }

  .value {
    font-size: var(--step-1);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  .hint {
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }
</style>
