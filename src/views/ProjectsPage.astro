---
import ProjectList from '@/components/projects/ProjectList.astro';
import PageHeader from '@/components/ui/PageHeader.astro';
import { projects } from '@/data/projects';
import type { Locale } from '@/i18n/locales';
import { pageMeta } from '@/i18n/pages';
import { alternatesFor } from '@/i18n/routes';
import { ogImagePath } from '@/seo/og';
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;

const meta = pageMeta('projects', locale);
---

<BaseLayout
  locale={locale}
  route="projects"
  alternates={alternatesFor('projects')}
  title={meta.title}
  description={meta.description}
  ogImage={ogImagePath(locale, 'projects')}
>
  <PageHeader title={meta.title} lead={meta.description} />
  <div class="container">
    <ProjectList locale={locale} projects={projects} headingLevel="h2" />
  </div>
</BaseLayout>
