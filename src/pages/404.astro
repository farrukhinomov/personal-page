---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { DEFAULT_LOCALE, LANG_TAG, LOCALES } from '@/i18n/locales';
import { alternatesFor, pathFor } from '@/i18n/routes';
import { useTranslations } from '@/i18n/ui';
import BaseLayout from '@/layouts/BaseLayout.astro';

// One 404 page serves both languages, so it shows the message in each, default locale first.
// The first message is the page's one h1; the others are h2 and look the same.
const messages = LOCALES.map((locale, index) => {
  const Heading: 'h1' | 'h2' = index === 0 ? 'h1' : 'h2';
  return { locale, t: useTranslations(locale), Heading };
});
const title = useTranslations(DEFAULT_LOCALE)('notFound.title');
---

<BaseLayout locale={DEFAULT_LOCALE} alternates={alternatesFor('home')} title={title} noindex>
  <section class="container not-found">
    <p class="code" aria-hidden="true">
      404
    </p>
    {messages.map(({ locale, t, Heading }) => (
      <div lang={LANG_TAG[locale]} class="message">
        <Heading class="heading">{t('notFound.title')}</Heading>
        <p>{t('notFound.body')}</p>
        <ButtonLink href={pathFor('home', locale)} variant="secondary">
          {t('notFound.back')}
        </ButtonLink>
      </div>
    ))}
  </section>
</BaseLayout>

<style>
  .not-found {
    display: grid;
    gap: var(--space-6);
    padding-block: var(--space-8);
  }

  .code {
    color: var(--color-signal);
    font-family: var(--font-mono);
    font-size: var(--step-5);
    line-height: 1;
  }

  .message {
    display: grid;
    justify-items: start;
    gap: var(--space-3);
  }

  .message + .message {
    padding-block-start: var(--space-6);
    border-block-start: 1px solid var(--color-line);
  }

  .heading {
    font-size: var(--step-3);
  }

  p {
    color: var(--color-fg-muted);
  }
</style>
