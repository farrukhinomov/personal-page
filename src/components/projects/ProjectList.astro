---
import type { Project } from '@/data/schema';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  projects: readonly Project[];
  /** Heading level of each Project name, so the outline stays correct. */
  headingLevel?: 'h2' | 'h3';
}

const { locale, projects, headingLevel: Heading = 'h3' } = Astro.props;

const copy = {
  de: {
    source: 'Quellcode',
    onRequest: 'Quellcode auf Anfrage',
    live: 'Live ansehen',
    stack: 'Technologien',
  },
  en: {
    source: 'Source code',
    onRequest: 'Source on request',
    live: 'View live',
    stack: 'Technologies',
  },
}[locale];
---

<ol class="project-list">
  {projects.map((project) => (
    <li class="project">
      <div class="meta">
        <span class="year">{project.year}</span>
      </div>
      <div class="body">
        <Heading class="name">{project.name}</Heading>
        <p class="tagline">{project.tagline[locale]}</p>
        <ul class="stack" aria-label={copy.stack}>
          {project.stack.map((tech) => (
            <li>{tech}</li>
          ))}
        </ul>
      </div>
      <div class="links">
        {project.visibility === 'public' ? (
          <a href={`https://github.com/${project.repository}`} rel="noopener">
            {copy.source}
          </a>
        ) : (
          <span class="private">{copy.onRequest}</span>
        )}
        {project.homepage && (
          <a href={project.homepage} rel="noopener">
            {copy.live}
          </a>
        )}
      </div>
    </li>
  ))}
</ol>

<style>
  .project-list {
    padding: 0;
    list-style: none;
    border-block-start: 1px solid var(--color-line);
  }

  .project {
    position: relative;
    display: grid;
    gap: var(--space-3) var(--space-6);
    padding-block: var(--space-6);
    border-block-end: 1px solid var(--color-line);
  }

  @media (min-width: 48rem) {
    .project {
      grid-template-columns: 6rem minmax(0, 1fr) auto;
      align-items: start;
    }
  }

  /* A signal line grows along the row on hover, showing which row the links belong to. */
  .project::before {
    content: '';
    position: absolute;
    inset-inline-start: 0;
    inset-block-end: -1px;
    width: 100%;
    height: 1px;
    background: var(--color-signal);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--duration-base) var(--ease-out);
  }

  .project:hover::before,
  .project:focus-within::before {
    transform: scaleX(1);
  }

  .year {
    color: var(--color-fg-muted);
    font-family: var(--font-mono);
    font-size: var(--step--1);
  }

  .name {
    font-size: var(--step-2);
  }

  .tagline {
    max-width: 60ch;
    margin-block-start: var(--space-2);
    color: var(--color-fg-muted);
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin-block-start: var(--space-4);
    padding: 0;
    list-style: none;
  }

  .stack li {
    padding: 0.1rem var(--space-2);
    border: 1px solid var(--color-line);
    border-radius: 0.3rem;
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    font-size: var(--step--1);
    font-weight: 500;
  }

  @media (min-width: 48rem) {
    .links {
      flex-direction: column;
      align-items: flex-end;
    }
  }

  .private {
    color: var(--color-fg-muted);
  }
</style>
