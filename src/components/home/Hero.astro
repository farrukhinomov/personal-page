---
import ButtonLink from '@/components/ui/ButtonLink.astro';
import Icon from '@/components/ui/Icon.astro';
import { cvPath } from '@/cv/paths';
import { yearsSince } from '@/data/dates';
import { profile } from '@/data/profile';
import { projects } from '@/data/projects';
import type { Locale } from '@/i18n/locales';
import { pageMeta } from '@/i18n/pages';
import { childPathFor } from '@/i18n/routes';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const years = yearsSince(profile.developerSince);
// The flagship is the first Project; the hero points recruiters straight to it.
const [flagship] = projects;

const copy = {
  de: {
    intro: `${profile.name}, Saarbrücken`,
    stack: ['C#/.NET', 'React/TypeScript', 'Python/Django', 'AI-gestützte Entwicklung'],
    stackLabel: 'Schwerpunkte',
    lead: 'Ich entwickle zuverlässige Business- und Compliance-Software – von der Architektur bis zum getesteten Deployment. Meine berufliche Grundlage ist die Entwicklung und der Betrieb von .NET-Anwendungen; in meinem GRC-Eigenprojekt setze ich einen React/TypeScript-Prototyp um und baue das Python/Django-/FastAPI-Backend schrittweise aus.',
    experience: `${years}+ Jahre Berufserfahrung in der Softwareentwicklung`,
    flagship: (name: string) => `${name} ansehen`,
    source: 'GitHub / Architektur',
    cv: 'Lebenslauf herunterladen (PDF)',
  },
  en: {
    intro: `${profile.name}, Saarbrücken, Germany`,
    stack: ['C#/.NET', 'React/TypeScript', 'Python/Django', 'AI-assisted development'],
    stackLabel: 'Focus areas',
    lead: 'I build reliable business and compliance software – from the architecture to a tested deployment. My professional foundation is building and running .NET applications; in my own GRC project I am building a React/TypeScript prototype and growing the Python/Django/FastAPI backend step by step.',
    experience: `${years}+ years of professional software development`,
    flagship: (name: string) => `View ${name}`,
    source: 'GitHub / architecture',
    cv: 'Download CV (PDF)',
  },
}[locale];

// Words are wrapped individually for the load sequence; spaces stay real text nodes.
const titleWords = pageMeta('home', locale).title.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-inner">
    <p class="intro enter" style="--delay: 0ms">
      {copy.intro}
    </p>
    <h1 id="hero-title" class="title">
      {titleWords.map((word, index) => (
        <>
          <span class="word" style={`--delay: ${80 + index * 55}ms`}>
            {word}
          </span>
          {index < titleWords.length - 1 && ' '}
        </>
      ))}
    </h1>
    <div class="stack-clip enter" style="--delay: 320ms">
      <ul class="stack" aria-label={copy.stackLabel}>
        {copy.stack.map((item) => (
          <li>{item}</li>
        ))}
      </ul>
    </div>
    <p class="lead enter" style="--delay: 420ms">
      {copy.lead}
    </p>
    <p class="experience enter" style="--delay: 480ms">
      {copy.experience}
    </p>
    {flagship && (
      <div class="actions enter" style="--delay: 560ms">
        <ButtonLink href={childPathFor('projects', locale, flagship.slug)}>
          {copy.flagship(flagship.name)}
        </ButtonLink>
        <ButtonLink href={cvPath(locale)} variant="secondary" download>
          {copy.cv}
        </ButtonLink>
        {flagship.visibility === 'public' && (
          <ButtonLink
            href={`https://github.com/${flagship.repository}#readme`}
            variant="secondary"
            rel="noopener"
          >
            <Icon name="github" />
            {copy.source}
          </ButtonLink>
        )}
      </div>
    )}
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(2.5rem, 1rem + 7vw, 8rem) var(--space-8);
    overflow: hidden;
  }

  /* An engineering grid that fades out: texture, not decoration with meaning. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--color-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-line) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 35%, #000 10%, transparent 75%);
    opacity: 0.55;
  }

  .hero-inner {
    display: grid;
    justify-items: start;
    gap: var(--space-5);
  }

  .intro {
    color: var(--color-fg-muted);
  }

  .title {
    max-width: 16ch;
    /* Smaller than --step-5 on phones, so the buttons stay above the fold. */
    font-size: clamp(2.4rem, 1.6rem + 4vw, 5.25rem);
    line-height: var(--leading-tight);
    letter-spacing: -0.035em;
    font-weight: 650;
  }

  /*
   * The stack reads as one line; separators are drawn, so screen readers hear a plain list.
   * Every item carries its dot in the padding before it. The list is shifted left by that
   * padding and the wrapper clips what sticks out, so the dot of an item that starts a row
   * is never seen, however the items wrap.
   */
  .stack-clip {
    overflow: hidden;
  }

  .stack {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1) 0;
    margin-inline-start: -1.5em;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--step-0);
    font-weight: 500;
  }

  .stack li {
    position: relative;
    padding-inline-start: 1.5em;
  }

  .stack li::before {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 0.6em;
    width: 0.3em;
    height: 0.3em;
    translate: 0 -50%;
    border-radius: 50%;
    background: var(--color-signal);
  }

  .lead {
    max-width: 60ch;
    font-size: clamp(1rem, 0.9rem + 0.6vw, var(--step-1));
    line-height: 1.5;
  }

  .experience {
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  /*
   * The page's one orchestrated moment: the headline rises word by word, then the rest follows.
   * Pure CSS, so it starts with first paint and never waits for JavaScript.
   */
  .word {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .word,
    .enter {
      animation: rise 700ms var(--ease-out) var(--delay, 0ms) both;
    }

    .word {
      animation-duration: 800ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
  }
</style>
