---
import Terminal from '@/components/home/terminal/Terminal.astro';
import ButtonLink from '@/components/ui/ButtonLink.astro';
import { yearsSince } from '@/data/dates';
import { profile } from '@/data/profile';
import type { Locale, Localized } from '@/i18n/locales';
import { pageMeta } from '@/i18n/pages';
import { pathFor } from '@/i18n/routes';

interface Props {
  locale: Locale;
  alternates: Localized;
}

const { locale, alternates } = Astro.props;
const years = yearsSince(profile.developerSince);

const copy = {
  de: {
    intro: `${profile.name}, Senior Full-Stack-Entwickler in Saarbrücken`,
    lead: `Seit ${years} Jahren baue ich mit C# und .NET Systeme für Unternehmen – von der Architektur bis zum Betrieb beim Kunden. Im Frontend arbeite ich mit React und TypeScript.`,
    primary: 'Kontakt aufnehmen',
    secondary: 'Projekte ansehen',
  },
  en: {
    intro: `${profile.name}, senior full-stack developer in Saarbrücken, Germany`,
    lead: `For ${years} years I have been building systems for companies with C# and .NET – from the architecture to running them at the customer. On the frontend I work with React and TypeScript.`,
    primary: 'Get in touch',
    secondary: 'See projects',
  },
}[locale];

// Words are wrapped individually for the load sequence; spaces stay real text nodes.
const titleWords = pageMeta('home', locale).title.split(' ');
---

<section class="hero" aria-labelledby="hero-title">
  <div class="container hero-grid">
    <div class="copy">
      <p class="intro enter" style="--delay: 0ms">
        {copy.intro}
      </p>
      <h1 id="hero-title" class="title">
        {titleWords.map((word, index) => (
          <>
            <span class="word" style={`--delay: ${80 + index * 55}ms`}>
              {word}
            </span>
            {index < titleWords.length - 1 && ' '}
          </>
        ))}
      </h1>
      <p class="lead enter" style="--delay: 420ms">
        {copy.lead}
      </p>
      <div class="actions enter" style="--delay: 600ms">
        <ButtonLink href={pathFor('contact', locale)}>{copy.primary}</ButtonLink>
        <ButtonLink href={pathFor('projects', locale)} variant="secondary">
          {copy.secondary}
        </ButtonLink>
      </div>
    </div>

    <div class="console enter" style="--delay: 700ms">
      <Terminal locale={locale} alternates={alternates} />
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(3.5rem, 2rem + 7vw, 8rem) var(--space-8);
    overflow: hidden;
  }

  /* An engineering grid that fades out: texture, not decoration with meaning. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(to right, var(--color-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--color-line) 1px, transparent 1px);
    background-size: 3.5rem 3.5rem;
    mask-image: radial-gradient(ellipse 70% 60% at 30% 35%, #000 10%, transparent 75%);
    opacity: 0.55;
  }

  .hero-grid {
    display: grid;
    gap: var(--space-7);
    align-items: center;
  }

  @media (min-width: 68rem) {
    .hero-grid {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      gap: var(--space-7);
    }
  }

  .copy {
    display: grid;
    gap: var(--space-5);
  }

  .intro {
    color: var(--color-fg-muted);
  }

  .title {
    max-width: 15ch;
    font-size: min(var(--step-5), 4.75rem);
    line-height: var(--leading-tight);
    letter-spacing: -0.035em;
    font-weight: 650;
  }

  .lead {
    max-width: 52ch;
    font-size: var(--step-1);
    line-height: 1.5;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-block-start: var(--space-2);
  }

  /*
   * The page's one orchestrated moment: the headline rises word by word, then the rest follows.
   * Pure CSS, so it starts with first paint and never waits for JavaScript.
   */
  .word {
    display: inline-block;
  }

  @media (prefers-reduced-motion: no-preference) {
    .word,
    .enter {
      animation: rise 700ms var(--ease-out) var(--delay, 0ms) both;
    }

    .word {
      animation-duration: 800ms;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(0.45em);
    }
  }
</style>
