---
import { profile } from '@/data/profile';
import type { Locale } from '@/i18n/locales';
import { useTranslations } from '@/i18n/ui';

interface Props {
  locale: Locale;
}

const t = useTranslations(Astro.props.locale);
const year = new Date().getFullYear();

const links = [
  { href: `mailto:${profile.email}`, label: profile.email },
  { href: profile.links.github, label: 'GitHub' },
  { href: profile.links.linkedin, label: 'LinkedIn' },
];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <p class="copyright">
      © {year} {profile.name}
    </p>
    <ul class="links">
      {links.map((link) => (
        <li>
          <a href={link.href} rel={link.href.startsWith('http') ? 'me noopener' : undefined}>
            {link.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="built-with">{t('footer.builtWith')}</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-block-start: var(--space-8);
    padding-block: var(--space-6);
    border-block-start: 1px solid var(--color-line);
    color: var(--color-fg-muted);
    font-size: var(--step--1);
  }

  .footer-grid {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3) var(--space-6);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2) var(--space-5);
    padding: 0;
    list-style: none;
  }

  .links a {
    color: var(--color-fg);
  }

  .built-with {
    margin-inline-start: auto;
  }
</style>
