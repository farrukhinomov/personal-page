---
import { getImage, Picture } from 'astro:assets';
import portrait from '@/assets/portrait/farrukh-inomov.jpg';
import codePortrait from '@/assets/portrait/farrukh-inomov-code.svg?url';
import { profile } from '@/data/profile';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
  /** `code`: from 56rem the animated code portrait replaces the photo; phones keep the photo. */
  variant?: 'photo' | 'code';
}

const { locale, variant = 'photo' } = Astro.props;
const alt = { de: `Porträt von ${profile.name}`, en: `Portrait of ${profile.name}` }[locale];

// The code variant shows the photo only as the 3.5rem phone circle, so 2x and 3x suffice.
const PHONE_WIDTHS = [112, 168];
const PHONE_SIZES = '3.5rem';
const phoneSources =
  variant === 'code'
    ? await Promise.all(
        (['avif', 'webp'] as const).map((format) =>
          getImage({ src: portrait, format, widths: PHONE_WIDTHS, sizes: PHONE_SIZES }),
        ),
      )
    : [];
const phoneFallback =
  variant === 'code' ? await getImage({ src: portrait, format: 'jpeg', width: 168 }) : undefined;
---

<!--
  A small circle beside the text on phones; from 56rem (the breakpoint of Hero and PageHeader)
  a 4:5 portrait whose corner marks echo the engineering grid behind the hero.
-->
<div class:list={['portrait', { 'portrait--code': variant === 'code' }]}>
  {
    phoneFallback ? (
      <picture>
        <source media="(min-width: 56rem)" srcset={codePortrait} type="image/svg+xml" />
        {phoneSources.map((image) => (
          <source
            srcset={image.srcSet.attribute}
            sizes={PHONE_SIZES}
            type={`image/${image.options.format}`}
          />
        ))}
        {/* The photo's dimensions; CSS aspect-ratio sets the box for the photo and the SVG alike. */}
        <img
          src={phoneFallback.src}
          alt={alt}
          width="1280"
          height="1600"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </picture>
    ) : (
      <Picture
        src={portrait}
        alt={alt}
        formats={['avif', 'webp']}
        widths={[144, 352, 528, 704]}
        sizes="(min-width: 56rem) 22rem, 3.5rem"
        loading="eager"
        fetchpriority="high"
      />
    )
  }
</div>

<style>
  .portrait {
    --mark: 1rem;
    --mark-width: 2px;
    --mark-offset: 0.625rem;
    position: relative;
    inline-size: 3.5rem;
  }

  .portrait :global(img) {
    display: block;
    inline-size: 100%;
    block-size: auto;
    aspect-ratio: 1;
    object-fit: cover;
    object-position: 50% 35%;
    border: 1px solid var(--color-line-strong);
    border-radius: 50%;
    background: var(--color-surface);
  }

  @media (min-width: 56rem) {
    .portrait {
      inline-size: clamp(16rem, 6rem + 14vw, 22rem);
    }

    .portrait :global(img) {
      aspect-ratio: 4 / 5;
      border-radius: var(--radius-panel);
    }

    /* The square SVG fills the 4:5 frame by height; its edges fade out, so the crop is soft. */
    .portrait--code :global(img) {
      object-position: 50% 50%;
      background: var(--color-screen);
    }

    /* Four L-shaped corner marks, each drawn as two bars. */
    .portrait::before {
      content: '';
      position: absolute;
      inset: calc(-1 * var(--mark-offset));
      pointer-events: none;
      background:
        linear-gradient(var(--color-signal) 0 0) left top / var(--mark) var(--mark-width),
        linear-gradient(var(--color-signal) 0 0) left top / var(--mark-width) var(--mark),
        linear-gradient(var(--color-signal) 0 0) right top / var(--mark) var(--mark-width),
        linear-gradient(var(--color-signal) 0 0) right top / var(--mark-width) var(--mark),
        linear-gradient(var(--color-signal) 0 0) left bottom / var(--mark) var(--mark-width),
        linear-gradient(var(--color-signal) 0 0) left bottom / var(--mark-width) var(--mark),
        linear-gradient(var(--color-signal) 0 0) right bottom / var(--mark) var(--mark-width),
        linear-gradient(var(--color-signal) 0 0) right bottom / var(--mark-width) var(--mark);
      background-repeat: no-repeat;
    }
  }
</style>
