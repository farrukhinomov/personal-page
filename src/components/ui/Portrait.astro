---
import portraitDark from '@/assets/portrait/farrukh-inomov-code-dark.svg?url';
import portraitLight from '@/assets/portrait/farrukh-inomov-code-light.svg?url';
import { profile } from '@/data/profile';
import type { Locale } from '@/i18n/locales';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const label = { de: `Porträt von ${profile.name}`, en: `Portrait of ${profile.name}` }[locale];
---

<!--
  The portrait drawn from code glyphs, borderless, in the theme's own colours: glowing cyan on
  dark, teal ink on light. A background image, so only the current theme's file is downloaded;
  the SVG animates itself and holds still under prefers-reduced-motion.
-->
<div
  class="portrait"
  role="img"
  aria-label={label}
  style={`--portrait-dark: url(${portraitDark}); --portrait-light: url(${portraitLight})`}
></div>

<style>
  .portrait {
    inline-size: clamp(10rem, 45vw, 14rem);
    aspect-ratio: 1;
    background: var(--portrait-dark) center / contain no-repeat;
  }

  :global([data-theme='light']) .portrait {
    background-image: var(--portrait-light);
  }

  @media (min-width: 56rem) {
    .portrait {
      inline-size: clamp(16rem, 6rem + 14vw, 22rem);
    }
  }
</style>
