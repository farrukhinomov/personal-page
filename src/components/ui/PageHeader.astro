---
interface Props {
  title: string;
  /** Shown after the title and never broken across lines, e.g. "GRC-SaaS-Prototyp". */
  suffix?: string | undefined;
  lead?: string;
}

const { title, suffix, lead } = Astro.props;
---

<header class="page-header">
  <div class="container">
    <h1>
      {title}
      {suffix && ' '}
      {suffix && <span class="suffix">— {suffix}</span>}
    </h1>
    {lead && <p class="lead">{lead}</p>}
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-7);
  }

  h1 {
    max-width: 18ch;
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
  }

  .suffix {
    white-space: nowrap;
  }

  .lead {
    max-width: 56ch;
    margin-block-start: var(--space-5);
    color: var(--color-fg-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
