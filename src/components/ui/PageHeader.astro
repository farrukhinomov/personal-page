---
interface Props {
  title: string;
  /** Shown after the title and never broken across lines, e.g. "GRC-SaaS-Prototyp". */
  suffix?: string | undefined;
  lead?: string;
}

const { title, suffix, lead } = Astro.props;
const hasPortrait = Astro.slots.has('portrait');
---

<header class="page-header">
  <div class:list={['container', { 'with-portrait': hasPortrait }]}>
    {hasPortrait && (
      <div class="portrait">
        <slot name="portrait" />
      </div>
    )}
    <div>
      <h1>
        {title}
        {suffix && ' '}
        {suffix && <span class="suffix">— {suffix}</span>}
      </h1>
      {lead && <p class="lead">{lead}</p>}
    </div>
  </div>
</header>

<style>
  .page-header {
    padding-block: clamp(3rem, 2rem + 5vw, 6rem) var(--space-7);
  }

  /* Phones: the portrait above the title. From 56rem (as in Portrait): beside it. */
  .with-portrait {
    display: grid;
    gap: var(--space-5);
  }

  @media (min-width: 56rem) {
    .with-portrait {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      column-gap: var(--space-7);
    }

    .portrait {
      grid-column: 2;
      grid-row: 1;
    }
  }

  /*
   * Long German compounds ("Datenschutzerklärung") are wider than a phone at this size,
   * so they hyphenate by the page language; only words of 12+ letters, never short ones.
   * Browsers without a German dictionary break the word without a hyphen instead.
   */
  h1 {
    max-width: 18ch;
    font-size: var(--step-4);
    line-height: var(--leading-tight);
    letter-spacing: -0.03em;
    hyphens: auto;
    hyphenate-limit-chars: 12 5 5;
    overflow-wrap: break-word;
  }

  /*
   * Never broken at its hyphens. On a narrow phone it would be wider than the page,
   * so it shrinks to fit: the longest suffix is about 10.3 times its font size wide,
   * and the container is the viewport minus both gutters. Wider screens keep 1em.
   */
  .suffix {
    font-size: min(1em, calc((100vw - 2 * var(--gutter)) / 11));
    white-space: nowrap;
  }

  .lead {
    max-width: 56ch;
    margin-block-start: var(--space-5);
    color: var(--color-fg-muted);
    font-size: var(--step-1);
    line-height: 1.5;
  }
</style>
