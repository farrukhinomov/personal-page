{
  "name": "inomov-online",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Farrukh Inomov's portfolio at inomov.online",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "serve .vercel/output/static --no-clipboard",
    "cv": "tsx scripts/cv/build.ts",
    "letter": "tsx scripts/cv/letter.ts",
    "health-check": "tsx scripts/health-check.ts",
    "mcp:server-json": "tsx scripts/mcp-server-json.ts",
    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:visual": "tsx scripts/visual-docker.ts",
    "test:lighthouse": "lhci autorun",
    "verify": "pnpm lint && pnpm format:check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.1.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.20",
    "@modelcontextprotocol/server": "2.4.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.41.0",
    "astro": "^7.4.7",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@fontsource/geist": "^5.3.0",
    "@lhci/cli": "0.16.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@playwright/test": "1.65.0",
    "@resvg/resvg-js": "^2.6.2",
    "@vitest/coverage-v8": "^5.1.0",
    "docx": "9.15.3",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "geist": "1.9.2",
    "globals": "^17.14.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.2",
    "satori": "^0.63.2",
    "serve": "14.2.7",
    "sharp": "0.35.5",
    "tsx": "4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0"
  }
}
